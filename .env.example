# ====================================================================
# AI INVESTMENT OS — environment configuration
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# All secrets live here. Everything else is code or data.
# ====================================================================

# --- SEC EDGAR (no key — but a User-Agent with your email is MANDATORY) ---
# SEC policy: identify yourself. Use a real email you control.
SEC_USER_AGENT="Aneesh Sahu aneesh@example.com"

# --- FRED (macro data) — free key, 2 min signup ---
# Get it: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=""

# --- SimFin (optional cross-check fundamentals) ---
# Get it: https://simfin.com/ (free account)
SIMFIN_API_KEY=""

# --- Tiingo EOD prices (optional reviewed fallback; user token required) ---
# Get it: https://www.tiingo.com/ — leave empty to use yfinance/Stooq only.
TIINGO_API_KEY=""

# --- LLM synthesis (NOT USED YET — reserved for later phase) ---
# Leave empty now. We wire this in only after the data layer is proven.
ANTHROPIC_API_KEY=""
ZAI_API_KEY=""

# --- Storage paths ---
# Relative to project root. Override per-environment if needed.
DUCKDB_PATH="data/aios.duckdb"
# Independent operating-incident ledger; remains writable if DuckDB is unavailable.
OPERATIONS_DB_PATH="data/operations/alerts.sqlite3"
RAW_DATA_DIR="data/raw"
PARQUET_DIR="data/parquet"
LOG_DIR="logs"

# --- Ingest tuning ---
# SEC fair-access: never exceed 10 req/s. We default lower to be safe.
EDGAR_MAX_RPS="8"
# Polite sleep for yfinance to avoid getting throttled.
YFINANCE_SLEEP_SEC="0.5"
# Retry isolated empty/error responses without changing the reviewed provider.
# Attempts are bounded; exhausted symbols still fail closed and create an incident.
YFINANCE_MAX_ATTEMPTS="3"
YFINANCE_RETRY_BASE_SEC="1.0"
# Interactive commands wait briefly for a dashboard query to finish. Scheduled
# jobs override this to five minutes so a harmless local overlap self-recovers.
DUCKDB_LOCK_WAIT_SECONDS="10"

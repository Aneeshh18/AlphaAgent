# --- Secrets & env ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
.streamlit/secrets.toml
.streamlit/secrets.*.toml
!.streamlit/secrets.toml.example

# Private keys and local credential stores. Public certificates such as
# audited *.pem/*.crt files remain eligible; private-key-shaped names do not.
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
private.pem
private-key.pem
private_key.pem
*private-key*.pem
*private_key*.pem
*-key.pem
*_key.pem
.aws/
.azure/
.config/gcloud/
.config/gh/
.docker/config.json
.gnupg/
.kube/
.password-store/
.ssh/
.terraform.d/
.git-credentials
.netrc
_netrc
.npmrc
.pypirc
pip.conf
kubeconfig
credentials
credentials.json
credentials.tfrc.json
application_default_credentials.json
service-account*.json
service_account*.json
token.json

# --- Data artifacts (never commit data; it is huge + often licensed) ---
data/
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
*.wal
*.bak
*.backup
*.dump
*.parquet
*.parquet.tmp
*.csv
*.json.gz

# Small, audited source manifests are code-like examples, not bulk market data.
!examples/*.csv

# Explicitly public, synthetic fixtures may exercise runtime formats. The
# repository metadata verifier still rejects secret-shaped names in this tree.
!tests/fixtures/public/*.duckdb
!tests/fixtures/public/*.sqlite
!tests/fixtures/public/*.sqlite3
!tests/fixtures/public/*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Test, type-checker, lint, and coverage output.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Local AI/design tooling (not runtime source) ---
.zcode/
.agents/
.claude/
.codex/
.impeccable/
.impeccable-live/
.impeccable-live.json
.code-review-graph/
skills-lock.json
agent.md

# Generated local briefs. Durable architecture, provenance, and release
# documents remain tracked because they are part of the governed system.
DESIGN.md
PRODUCT.md

# Keep GitHub CI/workflows eligible while excluding local agent mirrors.
.github/agents/
.github/hooks/
.github/skills/

# --- Project runtime artifacts ---
logs/
*.log
!tests/fixtures/public/*.log
runtime/
snapshots/
backups/

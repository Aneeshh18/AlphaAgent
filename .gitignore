# --- Secrets & env ---
.env
.env.*
!.env.example

# --- Data artifacts (never commit data; it is huge + often licensed) ---
data/
*.duckdb
*.duckdb.wal
*.parquet
*.parquet.tmp
*.csv
*.json.gz

# Small, audited source manifests are code-like examples, not bulk market data.
!examples/*.csv

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Local AI tooling (may contain provider credentials/cache) ---
.zcode/

# --- Project runtime artifacts ---
logs/
*.log
snapshots/
backups/
